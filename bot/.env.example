# Copia este archivo a `.env` y rellénalo. `.env` está en .gitignore: nunca se sube.
# Ninguna de estas variables tiene valor por defecto en el código. Si falta una que hace
# falta, el bot NO arranca — antes muerto que operando con una configuración a medias.

# ---------------------------------------------------------------------------
# MODO. "testnet" usa dinero de prueba. "live" usa DINERO REAL.
# Empieza en testnet y no lo cambies hasta que lleves semanas de datos.
# ---------------------------------------------------------------------------
TRADING_MODE=testnet

# Interruptor de armado. Con "false" (por defecto) el bot analiza y registra lo que HARÍA,
# pero no manda ni una orden. Ponlo en "true" solo cuando hayas leído sus decisiones y
# estés de acuerdo con ellas.
ARMED=false

# ---------------------------------------------------------------------------
# CLAVES
# Testnet spot:     https://testnet.binance.vision       (se entra con GitHub)
# Testnet futuros:  https://testnet.binancefuture.com    (claves DISTINTAS de las de spot)
# Permisos: lectura + trading. NUNCA des permiso de retirada a un bot.
# ---------------------------------------------------------------------------
BINANCE_SPOT_KEY=
BINANCE_SPOT_SECRET=
BINANCE_PERP_KEY=
BINANCE_PERP_SECRET=

# ---------------------------------------------------------------------------
# RIESGO. Todo en USDT.
# ---------------------------------------------------------------------------
MAX_NOTIONAL_PER_POSITION=200    # tamaño máximo de cada pata
MAX_TOTAL_NOTIONAL=1000          # exposición máxima sumando todas las posiciones
MAX_POSITIONS=3                  # posiciones simultáneas
DAILY_LOSS_STOP=50               # si el día acumula esta pérdida, se desarma solo

# ---------------------------------------------------------------------------
# ESTRATEGIA
# ---------------------------------------------------------------------------
# Solo se abre si la financiación media reciente cubre el coste de entrar y salir en
# menos de este número de cobros (cada cobro son 8 h, o sea 3 al día).
MAX_PERIODOS_HASTA_CUBRIR_COSTE=20
# Y solo si la financiación media es al menos esto (en %, por cobro). 0.005 = 0.005%
MIN_FUNDING_MEDIO_PCT=0.005
# Cuántos cobros pasados se promedian. Actuar sobre una sola lectura es ruido, no señal.
VENTANA_HISTORICO=24
# Se cierra la posición si la financiación media cae por debajo de esto.
CERRAR_SI_FUNDING_BAJA_DE_PCT=0.001

SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT

# Cada cuánto se revisa todo (segundos). No hace falta correr: esto no es una carrera.
INTERVALO_CICLO_S=60

# Puerto del panel de control local.
PORT=8787
