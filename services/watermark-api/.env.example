# Copia a .env y ajusta. Todas tienen valores por defecto seguros.
WM_API_KEYS=dev-key-cambia-esto           # claves válidas (coma-separadas)
WM_RATE_LIMIT_PER_MIN=60                   # peticiones por clave y minuto
WM_MAX_UPLOAD_BYTES=26214400               # 25 MB
WM_DATA_DIR=/tmp/watermark-api-data        # temporales (se borran por TTL)
WM_FILE_TTL_SECONDS=3600                    # borrado automático (privacidad)
WM_CORS_ORIGINS=*                          # orígenes permitidos (pon tu dominio en prod)
WM_REQUIRE_RIGHTS_ACK=true                 # exigir declaración de derechos para procesar
WM_WORKERS=2                               # hilos de proceso
